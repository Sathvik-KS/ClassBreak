# ClassBreak web environment variables
#
# Copy this file to frontend/.env.local and adjust if the backend is not on
# the default port. Vite reads these at build/dev-server start; restart
# `npm run dev` after changing them.
#
# VITE_* values are compiled into the browser bundle and are public.
# Never put API keys or other secrets here.

# Base URL of the ClassBreak FastAPI backend.
# Defaults to http://localhost:8000 when unset.
VITE_API_URL=http://localhost:8000
