# ClassBreak Backend Environment Variables
# Copy this file to .env and fill in your values

# AI Provider: "auto" (uses gemini if key set, else mock), "gemini", or "mock"
AI_PROVIDER=auto

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# CORS origins (comma-separated). 5173/4173 = Vite dev/preview,
# 8081 = Expo web (npx expo start --web). Add your own web origin if needed.
# Native Android/Expo Go requests are not subject to browser CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8081

# Rate limiting (format: <number>/<second|minute|hour|day>)
RATE_LIMIT=30/minute
# Source-search endpoint only (GET /api/sources/search)
RATE_LIMIT_READ=60/minute

# Generation limits
MAX_PROMPT_LENGTH=2000
MAX_RESPONSE_TOKENS=4096

# Seconds before a Gemini request is aborted
GEMINI_TIMEOUT=30.0
